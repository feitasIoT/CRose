<odoo>
    <data>
        <menuitem id="menu_fts_ai_root" name="AI Lab" web_icon="feitas_iot,static/description/icon.png" sequence="9"/>

        <record id="action_fts_ai_model" model="ir.actions.act_window">
            <field name="name">AI Models</field>
            <field name="res_model">fts.ai.model</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_fts_ai_dataset" model="ir.actions.act_window">
            <field name="name">Datasets</field>
            <field name="res_model">fts.ai.dataset</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_fts_ai_prompt" model="ir.actions.act_window">
            <field name="name">Prompts</field>
            <field name="res_model">fts.ai.prompt</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_fts_ai_training" model="ir.actions.act_window">
            <field name="name">Model Training</field>
            <field name="res_model">fts.ai.training</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_fts_ai_knowledge_document" model="ir.actions.act_window">
            <field name="name">Knowledge Documents</field>
            <field name="res_model">fts.ai.knowledge.document</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_fts_ai_category" model="ir.actions.act_window">
            <field name="name">Prompt Categories</field>
            <field name="res_model">fts.ai.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_fts_ai_knowledge_document" name="Knowledge" parent="menu_fts_ai_root" action="action_fts_ai_knowledge_document" sequence="10"/>
        <menuitem id="menu_fts_ai_dataset" name="Datasets" parent="menu_fts_ai_root" action="action_fts_ai_dataset" sequence="20"/>
        <menuitem id="menu_fts_ai_training" name="Model Training" parent="menu_fts_ai_root" action="action_fts_ai_training" sequence="30"/>
        <menuitem id="menu_fts_ai_model" name="Models" parent="menu_fts_ai_root" action="action_fts_ai_model" sequence="40"/>
        <menuitem id="menu_fts_ai_prompt" name="Prompts" parent="menu_fts_ai_root" action="action_fts_ai_prompt" sequence="50"/>
    </data>
</odoo>
