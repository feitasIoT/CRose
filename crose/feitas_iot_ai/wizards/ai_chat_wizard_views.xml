<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fts_ai_chat_wizard_form" model="ir.ui.view">
            <field name="name">fts.ai.chat.wizard.form</field>
            <field name="model">fts.ai.chat.wizard</field>
            <field name="arch" type="xml">
                <form string="Ask AI">
                    <group>
                        <field name="model_id"/>
                        <field name="use_knowledge"/>
                        <field name="top_k" invisible="not use_knowledge"/>
                    </group>
                    <group invisible="not use_knowledge">
                        <field name="document_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="user_text" nolabel="1" placeholder="Ask something..."/>
                        </page>
                        <page string="Reply">
                            <field name="reply_text" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_ask" type="object" string="Ask" class="btn-primary"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_fts_ai_chat_wizard" model="ir.actions.act_window">
            <field name="name">Ask AI</field>
            <field name="res_model">fts.ai.chat.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>

