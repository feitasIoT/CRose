<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fts_data_model_ai_flow_wizard_form" model="ir.ui.view">
            <field name="name">fts.data.model.ai.flow.wizard.form</field>
            <field name="model">fts.data.model.ai.flow.wizard</field>
            <field name="arch" type="xml">
                <form string="AI Flow">
                    <group>
                        <field name="data_model_id"/>
                        <field name="model_id"/>
                    </group>
                    <group>
                        <field name="temperature"/>
                        <field name="max_tokens"/>
                    </group>
                    <footer>
                        <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

