<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="feitas_iot.NrFlowViewer">
        <div class="feitas_iot_nr_flow_viewer"
             t-att-class="{
                 'feitas_iot_nr_flow_viewer_error': state.error,
                 'feitas_iot_nr_flow_viewer_empty': (state.nodes.length + state.groups.length) === 0 &amp;&amp; !state.error,
             }">

            <!-- Error banner -->
            <div t-if="state.error" class="alert alert-warning m-2" role="alert">
                <i class="fa fa-exclamation-triangle me-1"/>
                <t t-esc="state.error"/>
            </div>

            <!-- Empty / info state -->
            <div t-if="!state.error and (state.nodes.length + state.groups.length) === 0"
                 class="d-flex align-items-center justify-content-center text-muted"
                 style="height: 100%; min-height: 200px;">
                <span class="fa fa-code-fork me-2"/>
                <t t-esc="state.info or 'No flow to display'"/>
            </div>

            <!-- Flow SVG canvas -->
            <div t-if="!state.error and (state.nodes.length + state.groups.length) > 0"
                 class="feitas_iot_nr_flow_canvas_wrapper">
                <svg t-ref="container"
                     class="feitas_iot_nr_flow_svg"
                     xmlns="http://www.w3.org/2000/svg"
                     width="100%" height="100%"
                     preserveAspectRatio="xMidYMid meet"
                     t-on-pointerdown="_onPointerDown"
                     t-on-pointermove="_onPointerMove"
                     t-on-pointerup="_onPointerUp"
                     t-on-pointerleave="_onPointerUp"
                     t-on-wheel="_onWheel"
                     style="touch-action: none;">

                    <!-- Background grid pattern -->
                    <defs>
                        <pattern id="nr_flow_grid" width="20" height="20"
                                 patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none"
                                  stroke="#e8e8e8" stroke-width="0.5"/>
                        </pattern>
                    </defs>

                    <!-- Viewport transform group: pan + zoom -->
                    <g t-att-transform="viewport_transform">

                        <!-- Grid background -->
                        <rect t-att-x="grid_bounds.minX"
                              t-att-y="grid_bounds.minY"
                              t-att-width="grid_bounds.width"
                              t-att-height="grid_bounds.height"
                              fill="url(#nr_flow_grid)"/>

                        <!-- Groups layer (background containers) -->
                        <g class="feitas_nr_groups">
                            <t t-foreach="group_render_data" t-as="grp" t-key="grp.id">
                                <rect t-att-x="grp.rect.x"
                                      t-att-y="grp.rect.y"
                                      t-att-width="grp.rect.w"
                                      t-att-height="grp.rect.h"
                                      t-att-fill="grp.fill"
                                      t-att-fill-opacity="grp.fillOpacity"
                                      t-att-stroke="grp.stroke"
                                      t-att-stroke-opacity="grp.strokeOpacity"
                                      stroke-width="1.5"
                                      stroke-dasharray="6,3"
                                      rx="4" ry="4"
                                      class="feitas_nr_group_rect"/>
                                <text t-if="grp.showLabel"
                                      t-att-x="grp.label.x"
                                      t-att-y="grp.label.y"
                                      t-att-fill="grp.label.color"
                                      t-att-text-anchor="grp.label.anchor"
                                      font-size="11"
                                      font-weight="600"
                                      style="pointer-events: none; user-select: none;"
                                      t-esc="grp.label.text"/>
                            </t>
                        </g>

                        <!-- Wires layer -->
                        <g class="feitas_nr_wires">
                            <t t-foreach="wire_paths" t-as="wire" t-key="wire.key">
                                <path t-att-d="wire.path"
                                      fill="none"
                                      stroke="#718096"
                                      stroke-width="1.5"
                                      stroke-linecap="round"/>
                                <polygon t-if="wire.arrow"
                                          t-att-points="wire.arrow"
                                          fill="#718096"/>
                            </t>
                        </g>

                        <!-- Nodes layer -->
                        <g class="feitas_nr_nodes">
                            <t t-foreach="node_render_data" t-as="nd" t-key="nd.id">

                                <!-- Node body rect -->
                                <rect t-att-x="nd.rect.x"
                                      t-att-y="nd.rect.y"
                                      t-att-width="nd.rect.w"
                                      t-att-height="nd.rect.h"
                                      t-att-rx="nd.rect.rx"
                                      t-att-ry="nd.rect.ry"
                                      t-att-fill="nd.rect.fill"
                                      t-att-stroke="nd.rect.stroke"
                                      stroke-width="1"
                                      t-att-class="nd.rect.cssClass"/>

                                <!-- Type badge (left side icon square) -->
                                <t t-if="nd.badge">
                                    <rect t-att-x="nd.badge.x"
                                          t-att-y="nd.badge.y"
                                          t-att-width="nd.badge.w"
                                          t-att-height="nd.badge.h"
                                          t-att-rx="nd.badge.rx"
                                          t-att-ry="nd.badge.ry"
                                          t-att-fill="nd.badge.fill"/>
                                    <text t-att-x="nd.badge.textX"
                                          t-att-y="nd.badge.textY"
                                          text-anchor="middle"
                                          font-size="11"
                                          font-weight="bold"
                                          fill="white"
                                          style="pointer-events: none; user-select: none;"
                                          t-esc="nd.badge.letter"/>
                                </t>

                                <!-- Node label text -->
                                <text t-att-x="nd.label.x"
                                      t-att-y="nd.label.y"
                                      t-att-font-size="nd.label.fontSize"
                                      t-att-fill="nd.label.color"
                                      style="pointer-events: none; user-select: none;"
                                      class="feitas_nr_node_label"
                                      t-esc="nd.label.text"/>

                                <!-- Output port dots -->
                                <t t-foreach="nd.ports" t-as="port" t-key="port.key">
                                    <circle t-att-cx="port.cx"
                                            t-att-cy="port.cy"
                                            r="3"
                                            fill="#ffffff"
                                            stroke="#999999"
                                            stroke-width="0.5"/>
                                </t>
                            </t>
                        </g>

                    </g>
                </svg>

                <!-- Zoom controls overlay -->
                <div class="feitas_nr_zoom_controls">
                    <button class="btn btn-sm btn-light" title="Zoom in"
                            t-on-click.stop="_zoomIn">
                        <i class="fa fa-plus"/>
                    </button>
                    <span class="feitas_nr_zoom_label text-muted small"
                          t-esc="zoom_pct_label"/>
                    <button class="btn btn-sm btn-light" title="Zoom out"
                            t-on-click.stop="_zoomOut">
                        <i class="fa fa-minus"/>
                    </button>
                    <button class="btn btn-sm btn-light" title="Fit to screen"
                            t-on-click.stop="_fitToScreen">
                        <i class="fa fa-expand"/>
                    </button>
                </div>
            </div>

        </div>
    </t>

</templates>
