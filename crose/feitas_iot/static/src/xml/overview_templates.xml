<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="feitas_iot.OverviewDashboard">
        <div class="o_action p-4 feitas_iot_overview">
            <div class="mb-3 d-flex align-items-center justify-content-between">
                <h2 class="m-0">Dashboard</h2>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-primary" t-on-click="openAskAi">Ask AI</button>
                    <div class="btn-group" role="group" aria-label="Time Range">
                    <button type="button" t-att-class="'btn btn-sm ' + (state.timeRange === 'today' ? 'btn-primary' : 'btn-outline-primary')" t-on-click="() => this.changeTimeRange('today')">Today</button>
                    <button type="button" t-att-class="'btn btn-sm ' + (state.timeRange === 'week' ? 'btn-primary' : 'btn-outline-primary')" t-on-click="() => this.changeTimeRange('week')">Week</button>
                    <button type="button" t-att-class="'btn btn-sm ' + (state.timeRange === 'month' ? 'btn-primary' : 'btn-outline-primary')" t-on-click="() => this.changeTimeRange('month')">Month</button>
                    </div>
                </div>
            </div>
            <t t-if="state.loading">
                <div class="text-muted">Loading...</div>
            </t>
            <t t-elif="state.error">
                <div class="text-danger" t-esc="state.error"/>
            </t>
            <t t-else="">
                <t t-set="metrics" t-value="(state.overview &amp;&amp; state.overview.metrics) || {}"/>
                <t t-set="dashboard" t-value="(state.overview &amp;&amp; state.overview.dashboard) || {}"/>
                <t t-set="connectivity" t-value="dashboard.connectivity || {}"/>
                <t t-set="protocol" t-value="connectivity.protocol || {}"/>
                <t t-set="throughput" t-value="dashboard.throughput || {}"/>
                <t t-set="valueDelivery" t-value="dashboard.value_delivery || {}"/>
                <t t-set="asset" t-value="dashboard.asset_insight || {}"/>
                <t t-set="statusSummary" t-value="asset.status_summary || {}"/>

                <div class="border rounded p-2 bg-white mb-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                        <div class="d-flex flex-wrap gap-2 align-items-center" style="min-height: 42px;">
                            <t t-foreach="state.components || []" t-as="component" t-key="component.name">
                                <div class="border rounded px-2 py-1 bg-light d-flex align-items-center gap-2">
                                    <span t-att-class="'feitas_iot_status_dot ' + (component.status === 'online' ? 'feitas_iot_status_online' : 'feitas_iot_status_error')"/>
                                    <span class="small fw-semibold" t-esc="component.name"/>
                                </div>
                            </t>
                        </div>
                        
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-xl-4">
                        <div class="border rounded p-3 bg-white h-100">
                            <h5 class="m-0 mb-3">Connectivity &amp; Health</h5>
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="border rounded p-2 bg-light text-center">
                                        <div class="text-muted small">Total activities</div>
                                        <div class="fw-semibold fs-5"><t t-esc="protocol.total_activities || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2 bg-light text-center">
                                        <div class="text-muted small">Success</div>
                                        <div class="fw-semibold fs-5"><t t-esc="protocol.success || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2 bg-light text-center">
                                        <div class="text-muted small">Failed</div>
                                        <div class="fw-semibold fs-5"><t t-esc="protocol.failed || 0"/></div>
                                    </div>
                                </div>
                            </div>
                            <h6 class="m-0 mb-2">Data Throughput</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Records/sec</div>
                                        <div class="fw-semibold fs-5"><t t-esc="throughput.records_per_sec || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Today Records</div>
                                        <div class="fw-semibold fs-5"><t t-esc="throughput.records_today || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Reports Today</div>
                                        <div class="fw-semibold fs-5"><t t-esc="throughput.reports_today || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Latency (ms)</div>
                                        <div class="fw-semibold fs-5"><t t-esc="throughput.latency_ms || '-'"/></div>
                                    </div>
                                </div>
                            </div>
                            <h6 class="m-0 mt-3 mb-2">Resource Metrics</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="text-muted small">CPU</div>
                                            <div class="small fw-semibold"><t t-esc="metrics.cpu || '-'"/></div>
                                        </div>
                                        <svg viewBox="0 0 260 70" class="w-100">
                                            <polyline t-att-points="getMetricTrendPath('cpu')" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="text-muted small">Memory</div>
                                            <div class="small fw-semibold"><t t-esc="metrics.memory || '-'"/></div>
                                        </div>
                                        <svg viewBox="0 0 260 70" class="w-100">
                                            <polyline t-att-points="getMetricTrendPath('memory')" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="text-muted small">Disk</div>
                                            <div class="small fw-semibold"><t t-esc="metrics.disk || '-'"/></div>
                                        </div>
                                        <svg viewBox="0 0 260 70" class="w-100">
                                            <polyline t-att-points="getMetricTrendPath('disk')" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="text-muted small">Network</div>
                                            <div class="small fw-semibold"><t t-esc="metrics.network || '-'"/></div>
                                        </div>
                                        <svg viewBox="0 0 260 70" class="w-100">
                                            <polyline t-att-points="getMetricTrendPath('network')" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="border rounded p-3 bg-white h-100">
                            <h5 class="m-0 mb-3">Value Delivery</h5>
                            <div class="row g-2 mb-3">
                                <t t-foreach="valueDelivery.kpis || []" t-as="kpi" t-key="kpi.label">
                                    <div class="col-12">
                                        <div class="border rounded p-2 bg-light d-flex justify-content-between align-items-center">
                                            <div class="text-muted small" t-esc="kpi.label"/>
                                            <div class="fw-semibold fs-5" t-esc="kpi.value"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div class="border rounded p-2 bg-light">
                                <div class="text-muted small mb-1" t-esc="valueDelivery.trend_title || 'Trend'"/>
                                <svg viewBox="0 0 340 110" class="w-100 feitas_iot_trend_svg">
                                    <polyline t-att-points="getTrendPath()" fill="none" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="border rounded p-3 bg-white h-100">
                            <h5 class="m-0 mb-3">Asset Insight</h5>

                            <div class="border rounded p-2 bg-light mb-3">
                                <div class="row g-2 text-center">
                                    <div class="col-3 d-flex align-items-center justify-content-start ps-3">
                                        <div class="d-inline-flex align-items-center gap-2 fw-semibold">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                                                <path d="M12 10v.01"/>
                                                <path d="M9.17 7.17a4 4 0 0 1 5.66 0"/>
                                                <path d="M6.34 4.34a8 8 0 0 1 11.32 0"/>
                                                <rect x="3" y="14" width="18" height="6" rx="2" ry="2"/>
                                            </svg>
                                            <span>Gateways</span>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted small">Total</div>
                                        <div class="fw-semibold"><t t-esc="(statusSummary.gateway || {}).total || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Online</div>
                                        <div class="fw-semibold text-success"><t t-esc="(statusSummary.gateway || {}).online || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Offline</div>
                                        <div class="fw-semibold text-secondary"><t t-esc="(statusSummary.gateway || {}).offline || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Alert</div>
                                        <div class="fw-semibold text-danger"><t t-esc="(statusSummary.gateway || {}).abnormal || 0"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded p-2 bg-light mb-3">

                                <div class="row g-2 text-center">
                                    <div class="col-3 d-flex align-items-center justify-content-start ps-3">
                                        <div class="d-inline-flex align-items-center gap-2 fw-semibold">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                                                <rect x="6" y="6" width="12" height="12" rx="2" ry="2"/>
                                                <path d="M6 9H4"/>
                                                <path d="M6 15H4"/>
                                                <path d="M20 9h-2"/>
                                                <path d="M20 15h-2"/>
                                                <path d="M9 6V4"/>
                                                <path d="M15 6V4"/>
                                                <path d="M9 20v-2"/>
                                                <path d="M15 20v-2"/>
                                            </svg>
                                            <span>Edge Nodes</span>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted small">Total</div>
                                        <div class="fw-semibold"><t t-esc="(statusSummary.edge_node || {}).total || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Online</div>
                                        <div class="fw-semibold text-success"><t t-esc="(statusSummary.edge_node || {}).online || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Offline</div>
                                        <div class="fw-semibold text-secondary"><t t-esc="(statusSummary.edge_node || {}).offline || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Alert</div>
                                        <div class="fw-semibold text-danger"><t t-esc="(statusSummary.edge_node || {}).abnormal || 0"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded p-2 bg-light mb-3">

                                <div class="row g-2 text-center">
                                    <div class="col-3 d-flex align-items-center justify-content-start ps-3">
                                        <div class="d-inline-flex align-items-center gap-2 fw-semibold">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                                                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                                                <polyline points="2 12 12 17 22 12"/>
                                                <polyline points="2 17 12 22 22 17"/>
                                            </svg>
                                            <span>Instances</span>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted small">Total</div>
                                        <div class="fw-semibold"><t t-esc="(statusSummary.instance || {}).total || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Online</div>
                                        <div class="fw-semibold text-success"><t t-esc="(statusSummary.instance || {}).online || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Offline</div>
                                        <div class="fw-semibold text-secondary"><t t-esc="(statusSummary.instance || {}).offline || 0"/></div>
                                    </div>
                                    <div class="col-2">
                                        <div class="text-muted small">Alert</div>
                                        <div class="fw-semibold text-danger"><t t-esc="(statusSummary.instance || {}).abnormal || 0"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded p-2 bg-light mb-3">
                                <div class="text-muted small mb-1">Device Online Ratio</div>
                                <div class="progress mb-1" style="height: 10px;">
                                    <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: ' + getDeviceOnlinePct() + '%'" t-att-aria-valuenow="getDeviceOnlinePct()" aria-valuemin="0" aria-valuemax="100"/>
                                </div>
                                <div class="small text-muted">
                                    <t t-esc="asset.online_devices || 0"/> / <t t-esc="asset.devices_total || 0"/> online
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Devices</div>
                                        <div class="fw-semibold fs-5"><t t-esc="asset.devices_total || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Digital Models</div>
                                        <div class="fw-semibold fs-5"><t t-esc="asset.digital_models || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Running Flows</div>
                                        <div class="fw-semibold fs-5"><t t-esc="asset.running_flows || 0"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <div class="text-muted small">Commands Today</div>
                                        <div class="fw-semibold fs-5"><t t-esc="asset.commands_today || 0"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
