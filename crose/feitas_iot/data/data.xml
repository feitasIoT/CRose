<odoo>
<data noupdate="1">
    <record id="param_feitas_iot_encryption_secret" model="ir.config_parameter">
        <field name="key">feitas_iot.encryption_secret</field>
        <field name="value"></field>
    </record>

    <record id="seq_fts_data_model" model="ir.sequence">
        <field name="name">Data Model Sequence</field>
        <field name="code">fts.data.model</field>
        <field name="prefix">DM</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fts_ai_dataset_message" model="ir.sequence">
        <field name="name">AI Dataset Message Sequence</field>
        <field name="code">fts.ai.dataset.message</field>
        <field name="prefix">AIM</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
   

    <!-- System components -->
    <record id="component_nginx" model="crose.component">
        <field name="name">Nginx</field>
        <field name="component_type">nginx</field>
        <field name="host">nginx</field>
        <field name="port">80</field>
        <field name="mapped_port">18888</field>
        <field name="metadata">{"health_endpoint": "/health"}</field>
    </record>

    <record id="component_mqtt_broker" model="crose.component">
        <field name="name">MQTT Broker</field>
        <field name="component_type">mqtt</field>
        <field name="host">gmqtt</field>
        <field name="port">8082</field>
        <field name="mapped_port">18082</field>
        <field name="metadata">{"metrics_port": 8082,"metrics_endpoint": "/metrics","tcp_port": 1883,"ws_port": 8083}</field>
    </record>

    <record id="component_nodered" model="crose.component">
        <field name="name">Node-RED</field>
        <field name="component_type">nodered</field>
        <field name="host">nodered-prod</field>
        <field name="port">1880</field>
        <field name="mapped_port">11880</field>
        <field name="metadata">{"admin_path": "/admin", "health_endpoint": "/"}</field>
    </record>

    <record id="component_nodered_staging" model="crose.component">
        <field name="name">Node-RED Staging</field>
        <field name="component_type">nodered</field>
        <field name="host">nodered-staging</field>
        <field name="port">1880</field>
        <field name="mapped_port">11881</field>
        <field name="metadata">{"admin_path": "/admin", "health_endpoint": "/"}</field>
    </record>

    <record id="component_iotdb" model="crose.component">
        <field name="name">IoT DB</field>
        <field name="component_type">iotdb</field>
        <field name="host">iotdb</field>
        <field name="port">6667</field>
        <field name="mapped_port">16667</field>
        <field name="metadata">{"dn_rpc_port": 6667,"dn_internal_port": 10730}</field>
    </record>

    <!-- IoTDB预设的账户 -->
    <record id="component_iotdb_account_root" model="crose.component.account">
        <field name="component_id" ref="component_iotdb"/>
        <field name="username">root</field>
        <field name="password_encrypted">root</field>
        <field name="is_primary" eval="1"/>
        <field name="role">admin</field>
    </record>

    <record id="component_iotdb_account_crose_app" model="crose.component.account">
        <field name="component_id" ref="component_iotdb"/>
        <field name="username">crose_app</field>
        <field name="password_encrypted">crose</field>
        <field name="role">viewer</field>
    </record>

    <record id="component_iotdb_account_mqtt_client" model="crose.component.account">
        <field name="component_id" ref="component_iotdb"/>
        <field name="username">mqtt_client</field>
        <field name="password_encrypted">mqtt</field>
        <field name="role">operator</field>
    </record>

    <record id="component_crose_ai" model="crose.component">
        <field name="name">Crose AI</field>
        <field name="component_type">ai</field>
        <field name="host">ai</field>
        <field name="port">8000</field>
        <field name="metadata">{"health_endpoint": "/health", "embed_endpoint": "/embed", "train_api_path": "/v1/train", "train_status_api_path": "/v1/train/{job_id}", "load_adapter_api_path": "/v1/vllm/adapters/load", "unload_adapter_api_path": "/v1/vllm/adapters/unload", "infer_api_path": "/v1/vllm/chat"}</field>
    </record>

    <record id="component_nexus" model="crose.component">
        <field name="name">Nexus</field>
        <field name="component_type">npm</field>
        <field name="host">nexus</field>
        <field name="port">8081</field>
        <field name="mapped_port">18081</field>
        <field name="metadata">{
            "health_endpoint": "/",
            "node-red-stage": "/",
            "node-red-prod": "/",
            "docker-image": "/"
        }</field>
    </record>

    <record id="component_nexus_account_admin" model="crose.component.account">
        <field name="component_id" ref="component_nexus"/>
        <field name="username">admin</field>
        <field name="password_encrypted">admin123</field>
        <field name="role">admin</field>
    </record>

    <record id="component_redis" model="crose.component">
        <field name="name">Redis</field>
        <field name="component_type">redis</field>
        <field name="host">redis</field>
        <field name="port">6379</field>
        <field name="mapped_port">16379</field>
        <field name="metadata">{"db": 0}</field>
    </record>

    <record id="component_webdav" model="crose.component">
        <field name="name">webDAV</field>
        <field name="component_type">webdav</field>
        <field name="host">webdav</field>
        <field name="port">6065</field>
        <field name="mapped_port">16065</field>
        <field name="metadata">{"health_endpoint": "/api/health"}</field>
    </record>

    <record id="component_llama_factory" model="crose.component">
        <field name="name">LLama Factory</field>
        <field name="component_type">llama_factory</field>
        <field name="host">ai-train</field>
        <field name="port">8000</field>
        <field name="metadata">{"health_endpoint": "/health", "train_api_path": "/v1/train", "train_status_api_path": "/v1/train/{job_id}"}</field>
    </record>

    <record id="component_vllm" model="crose.component">
        <field name="name">vLLM</field>
        <field name="component_type">vllm</field>
        <field name="host">vllm</field>
        <field name="port">8000</field>
        <field name="metadata">{"health_endpoint": "/v1/models", "chat_completions_path": "/v1/chat/completions", "temperature": 0.1}</field>
    </record>

    <!-- node-red instance(fts.nr.instance) -->
    <record id="fts_nr_instance_prod" model="fts.nr.instance">
        <field name="name">Node-RED Prod</field>
        <field name="instance_type">local</field>
        <field name="ip_address">nodered</field>
        <field name="port">1880</field>
        <field name="editor_port">8880</field>
        <field name="component_id" ref="component_nodered" />
        <field name="mqtt_broker_id" ref="component_mqtt_broker" />
    </record>

    <record id="fts_nr_instance_staging" model="fts.nr.instance">
        <field name="name">Node-RED Staging</field>
        <field name="instance_type">local</field>
        <field name="ip_address">nodered-staging</field>
        <field name="port">1880</field>
        <field name="editor_port">8881</field>
        <field name="component_id" ref="component_nodered_staging" />
        <field name="mqtt_broker_id" ref="component_mqtt_broker" />
    </record>


 </data>
</odoo>
