<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_edge_node_deploy_wizard_form" model="ir.ui.view">
        <field name="name">edge.node.deploy.wizard.form</field>
        <field name="model">edge.node.deploy.wizard</field>
        <field name="arch" type="xml">
            <form string="Deploy Edge Node">
                <group>
                    <field name="node_has_docker" invisible="1"/>
                    <field name="node_has_nodered" invisible="1"/>
                    <field name="node_has_mqtt_broker" invisible="1"/>
                    <field name="node_uses_redis" invisible="1"/>

                    <field name="docker_invisible" invisible="1"/>
                    <field name="nodered_invisible" invisible="1"/>
                    <field name="another_nodered_invisible" invisible="1"/>
                    <field name="mqtt_broker_invisible" invisible="1"/>
                    <field name="redis_invisible" invisible="1"/>

                    <field name="docker" invisible="docker_invisible"/>

                    <field name="nodered" invisible="nodered_invisible"/>

                    <field name="another_nodered" invisible="another_nodered_invisible"
                        string="Additional Node-RED"/>

                    <field name="mqtt_broker" invisible="mqtt_broker_invisible"/>

                    <field name="redis" invisible="redis_invisible"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Deploy" type="object"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_edge_node_deploy_wizard" model="ir.actions.act_window">
        <field name="name">Deploy Edge Node</field>
        <field name="res_model">edge.node.deploy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_edge_node_deploy_wizard_form"/>
    </record>
</odoo>
