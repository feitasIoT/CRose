<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crose_component_tree" model="ir.ui.view">
            <field name="name">crose.component.tree</field>
            <field name="model">crose.component</field>
            <field name="arch" type="xml">
                <list string="System Components">
                    <field name="name"/>
                    <field name="component_type"/>
                    <field name="host"/>
                    <field name="port"/>
                    <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status == 'error'" decoration-muted="status == 'offline'"/>
                    <field name="error_reason" optional="hide" />
                    <field name="last_check_time"/>
                </list>
            </field>
        </record>

        <record id="view_crose_component_form" model="ir.ui.view">
            <field name="name">crose.component.form</field>
            <field name="model">crose.component</field>
            <field name="arch" type="xml">
                <form string="System Component">
                    <header>
                        <button name="action_check_status" type="object" string="Check Status" class="oe_highlight"/>
                        <button name="action_synchronize_mqtt_accounts" type="object" string="Synchronize" class="btn-secondary" invisible="component_type != 'mqtt'"/>
                        <button name="action_reset_credentials" type="object" string="Reset Credentials" class="btn-secondary" invisible="component_type == 'llm_provider'"/>
                        <button name="action_update_privileges" type="object" string="Update Privileges" class="btn-secondary" invisible="component_type != 'iotdb'"/>
                        <button name="action_view_packages" type="object" string="View Packages"
                                invisible="component_type != 'npm'"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_component_accounts" type="object" class="oe_stat_button" icon="fa-users" invisible="component_type != 'mqtt'">
                                <field name="mqtt_user_count" widget="statinfo" string="Users"/>
                            </button>
                            <button name="action_view_mqtt_topics" type="object" class="oe_stat_button" icon="fa-tags" invisible="component_type != 'mqtt'">
                                <field name="mqtt_topic_count" widget="statinfo" string="Topics"/>
                            </button>
                        </div>
                        <div class="alert alert-danger mb-2" role="alert" invisible="status == 'online' or not error_reason">
                            <strong>Check failed:</strong> <field name="error_reason" nolabel="1"/>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Component Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="component_type"/>
                                <field name="host"/>
                                <field name="port"/>
                            </group>
                            <group>
                                <field name="last_check_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Metadata">
                                <field name="metadata" widget="code" options="{'mode': 'javascript'}"/>
                            </page>
                            <page string="Accounts">
                                <field name="account_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="username"/>
                                        <field name="is_primary"/>
                                        <field name="role"/>
                                        <field name="iotdb_privileges"/>
                                        <field name="modified_by" readonly="1" optional="hide"/>
                                        <field name="modified_at" readonly="1" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crose_component" model="ir.actions.act_window">
            <field name="name">System Components</field>
            <field name="res_model">crose.component</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_crose_component_account_tree" model="ir.ui.view">
            <field name="name">crose.component.account.tree</field>
            <field name="model">crose.component.account</field>
            <field name="arch" type="xml">
                <list>
                    <field name="username"/>

                </list>
            </field>
        </record>


    </data>
</odoo>
