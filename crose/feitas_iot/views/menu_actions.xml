<odoo>
    <data>


        <!-- Actions -->
        <record id="action_fts_nr_instance" model="ir.actions.act_window">
            <field name="name">Instances</field>
            <field name="res_model">fts.nr.instance</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_group_by_instance_type': 1}</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('feitas_iot.view_fts_instance_kanban')}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('feitas_iot.view_fts_instance_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('feitas_iot.view_fts_instance_form')})
            ]"/>
        </record>

        <record id="action_fts_nr_flow" model="ir.actions.act_window">
            <field name="name">Flows</field>
            <field name="res_model">fts.nr.flow</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('is_template', '=', False)]</field>
            <field name="context">
                {
                    'default_is_template': False,
                    'search_default_group_by_instance': 1
                }
            </field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('feitas_iot.view_fts_nr_flow_kanban')})
            ]"/>
        </record>

        <record id="action_fts_nr_flow_template" model="ir.actions.act_window">
            <field name="name">Apps</field>
            <field name="res_model">fts.nr.flow</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('is_template', '=', True)]</field>
            <field name="context">{'default_is_template': True}</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('feitas_iot.view_fts_nr_flow_app_kanban')})
            ]"/>
        </record>

        <record id="action_fts_edge_agent" model="ir.actions.act_window">
            <field name="name">Edge Nodes</field>
            <field name="res_model">fts.edge.node</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_ids" eval="[]"/>
        </record>

        <record id="action_fts_iot_overview" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">feitas_iot.overview</field>
        </record>


        <!-- Workbench -->
        <menuitem id="menu_crose_workbench" name="Workbench" web_icon="feitas_iot,static/description/icon.png" sequence="6"/>
        <menuitem id="menu_crose_workbench_dashboard" name="Dashboard" parent="menu_crose_workbench" action="action_fts_iot_overview" sequence="1"/>
        <menuitem id="menu_crose_workbench_alerts" name="Alerts" parent="menu_crose_workbench" action="feitas_iot.action_fts_alert" sequence="2"/>

        <!-- Data Factory -->
        <menuitem id="menu_crose_data_factory" name="Data Factory" web_icon="feitas_iot,static/description/icon.png" sequence="8"/>
        
        
        <record id="action_fts_data_model" model="ir.actions.act_window">
            <field name="name">Modeling</field>
            <field name="res_model">fts.data.model</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('feitas_iot.view_fts_data_model_kanban')}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('feitas_iot.view_fts_data_model_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('feitas_iot.view_fts_data_model_form')})
            ]"/>
        </record>

        <record id="action_fts_data_asset" model="ir.actions.act_window">
            <field name="name">Assets</field>
            <field name="res_model">fts.data.asset</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('feitas_iot.view_fts_data_asset_kanban')}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('feitas_iot.view_fts_data_asset_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('feitas_iot.view_fts_data_asset_form')})
            ]"/>
        </record>

        <menuitem
            id="menu_fts_data_model"
            name="Modeling"
            parent="menu_crose_data_factory"
            action="action_fts_data_model"
            sequence="5"
        />

        <menuitem
            id="menu_fts_data_asset"
            name="Assets"
            parent="menu_crose_data_factory"
            action="action_fts_data_asset"
            sequence="10"
        />

        

        <!-- Edge Management -->
        <menuitem id="menu_crose_edge_management" name="Edge Management" web_icon="feitas_iot,static/description/icon.png" sequence="7"/>
        <menuitem id="menu_crose_edge_nodes" name="Edge Nodes" parent="menu_crose_edge_management" action="action_fts_edge_agent" sequence="10"/>
        <menuitem id="menu_crose_app_store" name="App Store" parent="menu_crose_edge_management" action="action_fts_nr_flow_template" sequence="15"/>
        <menuitem id="menu_crose_deployments" name="Deployments" parent="menu_crose_edge_management" action="action_fts_nr_instance" sequence="20"/>
        <menuitem id="menu_crose_flows" name="Flows" parent="menu_crose_edge_management" action="action_fts_nr_flow" sequence="30"/>

        <!-- Infrastructure -->
        <menuitem id="menu_fts_crose_config" 
            name="Infrastructure" web_icon="feitas_iot,static/description/icon.png" sequence="10"/>

        <menuitem
            id="menu_crose_component"
            name="System Components"
            parent="menu_fts_crose_config"
            action="action_crose_component"
            sequence="20"
        />

        <record id="action_fts_agent_release" model="ir.actions.act_window">
            <field name="name">Agent Package</field>
            <field name="res_model">ir.attachment</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('res_model', '=', 'crose.agent.package')]</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('feitas_iot.view_fts_agent_package_list')})
            ]"/>
            <field name="context" eval="{'default_res_model': 'crose.agent.package'}"/>
        </record>

        <menuitem id="menu_fts_agent_release" 
            name="Agent Package" parent="menu_fts_crose_config" action="action_fts_agent_release" sequence="50"/>
        

        <record id="action_fts_nr_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">fts.nr.tag</field>
            <field name="view_mode">list</field>
        </record>

    </data>
 </odoo>
