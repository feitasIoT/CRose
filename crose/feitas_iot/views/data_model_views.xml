<odoo>
    <data>
        <!-- Search View -->
        <record id="view_fts_data_model_search" model="ir.ui.view">
            <field name="name">fts.data.model.search</field>
            <field name="model">fts.data.model</field>
            <field name="arch" type="xml">
                <search string="Data Model">
                    <field name="name"/>
                    <field name="data_asset_id"/>
                    <field name="provider_id"/>
                    <field name="data_asset"/>
                    <field name="topic"/>
                    <field name="partner_id"/>
                    <field name="mqtt_topic_id"/>
                    <field name="nr_instance_id"/>
                    <field name="state"/>
                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Effective" name="state_effective" domain="[('state', '=', 'effective')]"/>
                    <group>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Requester" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Instance" name="group_by_instance" context="{'group_by': 'nr_instance_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_fts_data_model_form" model="ir.ui.view">
            <field name="name">fts.data.model.form</field>
            <field name="model">fts.data.model</field>
            <field name="arch" type="xml">
                <form string="Data Model">
                    <header>
                        <button name="action_start" type="object" string="Start" class="btn-primary" invisible="is_demo"/>
                        <button name="action_start_demo" type="object" string="Start Demo" class="btn-primary" invisible="is_demo != True"/>
                        <button name="action_generate_flow_ai" type="object" string="AI Flow" class="btn-secondary"/>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(feitas_iot.action_fts_data_address)d" type="action" class="oe_stat_button" icon="fa-sitemap">
                                <field name="address_ids" widget="statinfo" string="Addresses"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            
                            <field name="description"/>
                            
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="data_asset_ids" widget="many2many_tags" />
                                <field name="partner_id"/>
                                <field name="provider_id" readonly="1"/>
                                <field name="mqtt_topic_id" invisible="protocol != 'mqtt'"/>
                                <field name="nr_instance_id"/>
                                <field name="nr_flow_ids" widget="many2many_tags" 
                                    domain="[('instance_id', '=', nr_instance_id), ('type', '=', 'tab')]"/>
                            </group>
                            <group>
                                <field name="protocol" />
                                <field name="host" />
                                <field name="tcp_port" />
                                <field name="serial_port" invisible="protocol != 'serial'" />
                                <field name="tcp_type" invisible="protocol != 'tcp'" />
                                <field name="slave_id" invisible="protocol != 'modbus'" />
                                <field name="smb_share" invisible="protocol != 'smb'" />
                                <field name="username" invisible="protocol != 'smb'" />
                                <field name="password" invisible="protocol != 'smb'" />
                            </group>
                        </group>
                        <notebook>
                            <page name="datas_search" string="Data Query">
                                <group>
                                    <group>
                                        <field name="query_type"/>
                                        <field name="query_data_asset_ids" widget="many2many_tags" />
                                        <field name="query_interval" invisible="query_type != 'data'"/>
                                    </group>
                                    <group>
                                        <field name="query_start_time" invisible="query_type != 'data'"/>
                                        <field name="query_end_time" invisible="query_type != 'data'"/>
                                        <button name="action_test_query" type="object" string="Test" class="oe_highlight"/>
                                        <button name="action_open_spreadsheet" type="object" string="Spreadsheet" class="oe_highlight"/>
                                    </group>
                                </group>
                            </page>
                            <page name="datas" string="Data Structure">
                                <field name="data_structure" widget="code" options="{'mode': 'javascript'}" nolabel="1" colspan="2"/>
                            </page>
                            <page name="application" string="Applications">
                                <group style="margin-bottom: 10px !important">
                                    
                                    <field name="app_param_ids" nolabel="1" colspan="4">
                                        <list editable="bottom">
                                            <field name="name"/>
                                            <field name="value"/>
                                            <field name="type"/>
                                            <field name="description"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="others" string="Others" >
                                <group>
                                    <group>
                                        <field name="is_demo" groups="base.group_no_one" />
                                    </group>
                                    <group>
                                        <field name="data_asset" readonly="1" groups="base.group_no_one" />
                                        <field name="topic" readonly="1" groups="base.group_no_one" />
                                        <field name="iotdb_topic" readonly="1" groups="base.group_no_one" />
                                    </group>
                                </group>
                            </page> 
                        </notebook>
                            
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_fts_data_model_tree" model="ir.ui.view">
            <field name="name">fts.data.model.tree</field>
            <field name="model">fts.data.model</field>
            <field name="arch" type="xml">
                <list string="Data Model">
                    <field name="name"/>
                    <field name="data_asset_id"/>
                    <field name="provider_id"/>
                    <field name="data_asset"/>
                    <field name="topic"/>
                    <field name="partner_id"/>
                    <field name="mqtt_topic_id"/>
                    <field name="nr_instance_id"/>
                    <field name="state" widget="badge" decoration-success="state == 'effective'" decoration-info="state == 'draft'" decoration-warning="state == 'approval'" decoration-muted="state == 'invalid'"/>
                </list>
            </field>
        </record>

        <record id="view_fts_data_model_kanban" model="ir.ui.view">
            <field name="name">fts.data.model.kanban</field>
            <field name="model">fts.data.model</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="data_asset_id"/>
                    <field name="data_status"/>
                    <field name="state"/>
                    <field name="protocol"/>
                    <field name="nr_instance_id"/>
                    <field name="partner_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click o_kanban_record feitas_iot_instance_kanban_card">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <span t-att-class="'feitas_iot_status_dot ' + (record.data_status.raw_value === 'normal' ? 'feitas_iot_status_online' : 'feitas_iot_status_error')"/>
                                            <strong class="text-truncate">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <span class="badge text-bg-light">
                                            <field name="data_status"/>
                                        </span>
                                    </div>
                                    <div class="row g-1">
                                        <div class="col-6 text-start">
                                            <div class="small text-muted">Asset</div>
                                            <div class="small text-truncate"><field name="data_asset_id"/></div>
                                        </div>
                                        <div class="col-6 text-end">
                                            <div class="small text-muted">Protocol</div>
                                            <div class="small text-truncate"><field name="protocol"/></div>
                                        </div>
                                    </div>
                                    <div class="row g-1">
                                        <div class="col-6 text-start">
                                            <div class="small text-muted">Requester</div>
                                            <div class="small text-truncate"><field name="partner_id"/></div>
                                        </div>
                                        <div class="col-6 text-end">
                                            <div class="small text-muted">State</div>
                                            <div class="small text-truncate"><field name="state"/></div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="small text-muted">Instance</span>
                                        <span class="small text-truncate"><field name="nr_instance_id"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>



    </data>
</odoo>
