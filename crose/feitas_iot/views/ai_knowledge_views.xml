<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fts_ai_knowledge_document_list" model="ir.ui.view">
            <field name="name">fts.ai.knowledge.document.list</field>
            <field name="model">fts.ai.knowledge.document</field>
            <field name="arch" type="xml">
                <list string="Knowledge Documents">
                    <field name="name"/>
                    <field name="source_type"/>
                    <field name="chunk_count"/>
                    <field name="vectorized_chunk_count"/>
                </list>
            </field>
        </record>

        <record id="view_fts_ai_knowledge_document_form" model="ir.ui.view">
            <field name="name">fts.ai.knowledge.document.form</field>
            <field name="model">fts.ai.knowledge.document</field>
            <field name="arch" type="xml">
                <form string="Knowledge Document">
                    <header>
                        <button name="action_split_and_vectorize" string="Split &amp; Vectorize" type="object" class="btn-primary"/>
                        <button name="action_split" string="Split" type="object"/>
                        <button name="action_vectorize_chunks" string="Vectorize Missing Chunks" type="object"/>
                        <button name="%(feitas_iot.action_fts_ai_knowledge_rag_wizard)d" string="Test RAG" type="action" context="{'default_document_ids': [id]}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="For example: Product Manual"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Source">
                                <field name="source_type"/>
                            </group>
                            <group string="Chunking">
                                <field name="chunk_size"/>
                                <field name="chunk_overlap"/>
                                <field name="chunk_count" readonly="1"/>
                                <field name="vectorized_chunk_count" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Content">
                                <field name="raw_text" nolabel="1"/>
                            </page>
                            <page string="Chunks">
                                <field name="chunk_ids">
                                    <list editable="bottom">
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="is_vectorized" widget="boolean_toggle"/>
                                    </list>
                                    <form string="Chunk">
                                        <sheet>
                                            <group>
                                                <field name="document_id" readonly="1"/>
                                                <field name="sequence"/>
                                                <field name="name"/>
                                                <field name="is_vectorized" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="content" nolabel="1"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record id="view_fts_ai_knowledge_chunk_list" model="ir.ui.view">
            <field name="name">fts.ai.knowledge.chunk.list</field>
            <field name="model">fts.ai.knowledge.chunk</field>
            <field name="arch" type="xml">
                <list string="Knowledge Chunks">
                    <field name="document_id"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="is_vectorized" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_fts_ai_knowledge_chunk_form" model="ir.ui.view">
            <field name="name">fts.ai.knowledge.chunk.form</field>
            <field name="model">fts.ai.knowledge.chunk</field>
            <field name="arch" type="xml">
                <form string="Knowledge Chunk">
                    <header>
                        <button name="action_vectorize" string="Vectorize" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="document_id"/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="is_vectorized" readonly="1"/>
                        </group>
                        <group>
                            <field name="content" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
    </data>
</odoo>
