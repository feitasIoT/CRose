<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crose_res_config_settings" model="ir.ui.view">
            <field name="name">crose.res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="CRose" name="feitas_iot" groups="base.group_system">
                        <block title="General">
                            <setting string="Tags">
                                <button type="action" name="%(feitas_iot.action_fts_nr_tag)d" string="Manage" class="btn-link"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_crose_settings" model="ir.actions.act_window">
            <field name="name">CRose Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

        <menuitem id="menu_crose_settings"
                  name="CRose"
                  parent="base.menu_config"
                  action="feitas_iot.action_crose_settings"
                  sequence="60"
                  groups="base.group_system"/>
    </data>
</odoo>

