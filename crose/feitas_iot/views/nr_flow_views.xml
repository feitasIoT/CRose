<odoo>
    <data>

        <!-- Search view -->
        <record id="view_fts_nr_flow_search" model="ir.ui.view">
            <field name="name">fts.nr.flow.search</field>
            <field name="model">fts.nr.flow</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="tag_ids"/>
                    <group>
                        <filter string="Instance" name="group_by_instance" context="{'group_by': 'instance_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_fts_nr_flow_tree" model="ir.ui.view">
            <field name="name">fts.nr.flow.tree</field>
            <field name="model">fts.nr.flow</field>
            <field name="arch" type="xml">
                <list string="Node-RED Flow">
                    <field name="name"/>
                    <field name="instance_id"/>
                    <field name="nr_id"/>
                    <field name="type"/>
                    <button name="action_view_nodes" type="object" icon="fa-sitemap" title="Nodes"/>
                </list>
            </field>
        </record>

        <!-- Kanban view for app(template)-->
        <record id="view_fts_nr_flow_app_kanban" model="ir.ui.view">
            <field name="name">fts.nr.flow.app.kanban</field>
            <field name="model">fts.nr.flow</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="tag_ids"/>
                    <field name="image" />
                    <field name="heat"/>
                    <field name="is_listed"/>
                    <field name="is_valid"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <!-- <aside class="w-25 p-1">
                                <field name="avatar_128" widget="image" alt="Avatar"/>
                            </aside> -->
                            <main class="w-100 ps-2 pt-1">
                                <div>
                                    <div class="text-success float-end mb4">
                                        <i class="fa fa-fire me-1" title="Heat"/><field name="heat"/>
                                    </div>
                                    <field class="fw-bold" name="name"/>
                                </div>
                                <div class="mb-1">
                                    <span class="badge text-bg-success me-1" invisible="not is_listed">Listed</span>
                                    <span class="badge text-bg-secondary me-1" invisible="is_listed">Unlisted</span>
                                    <span class="badge text-bg-primary" invisible="not is_valid">Valid</span>
                                    <span class="badge text-bg-danger" invisible="is_valid">Invalid</span>
                                </div>
                                
                                <div>
                                    <span class="mb4 text-truncate" title="Tags">
                                        <field name="tag_ids" />
                                    </span>
                                </div>

                                <t t-if="record.image.raw_value">
                                    <field name="image" widget="image"/>
                                </t>
                            </main>
                        </t>
                        
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- for menu flows -->
        <record id="view_fts_nr_flow_kanban" model="ir.ui.view">
            <field name="name">fts.nr.flow.kanban</field>
            <field name="model">fts.nr.flow</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="tag_ids"/>
                    <field name="create_date"/>
                    <field name="node_count"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <main class="w-100 ps-2 pt-1">
                                <!-- 上：标题 -->
                                <div class="mb-1">
                                    <field class="fw-bold" name="name"/>
                                </div>
                                <!-- 中：字段值（左/右） -->
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted small">
                                        <field name="create_date"/>
                                    </span>
                                    <span class="badge text-bg-light">
                                        <field name="node_count"/> nodes
                                    </span>
                                </div>
                                <!-- 下：图标类字段（左/右） -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-truncate" title="Tags">
                                        <field name="tag_ids"/>
                                    </span>
                                    <span class="badge text-bg-success" t-if="record.state.raw_value == 'active'">Active</span>
                                    <span class="badge text-bg-danger" t-if="record.state.raw_value == 'disabled'">Disabled</span>
                                </div>
                            </main>
                        </t>
                        
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_fts_nr_flow_form" model="ir.ui.view">
            <field name="name">fts.nr.flow.form</field>
            <field name="model">fts.nr.flow</field>
            <field name="arch" type="xml">
                <form string="Node-RED Flow">
                    <header>
                        <button name="action_publish_app" string="Publish App" type="object" class="btn-primary" 
                            invisible="is_template or app_store_id"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_nodes" type="object" class="oe_stat_button" icon="fa-sitemap">
                                <field name="node_count" widget="statinfo" string="Nodes"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="tag_ids" widget="many2many_tags" />
                            </group>
                            <group>
                                <field name="description" widget="html" nolabel="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="image" widget="image" nolabel="1"/>
                            </page>
                            <!-- <page string="Prompt">
                                <field name="prompt" nolabel="1"/>
                            </page> -->
                            <page string="Content">
                                <field name="content" widget="code" options="{'mode': 'javascript'}" nolabel="1"/>
                            </page>
                            <page string="Flow Diagram">
                                <group>
                                    <field name="content" widget="nr_flow_viewer" nolabel="1" colspan="2"/>
                                </group>
                            </page>
                            <page string="Parameters">
                                <field name="param_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="value"/>
                                        <field name="type"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Automation">
                                <field name="automation_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="model_id"/>
                                        <field name="trigger"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Others">
                                <group>
                                    <group>
                                        <field name="instance_id" invisible="is_template"/>
                                        <field name="nr_id" invisible="is_template"/>
                                        <field name="type" invisible="is_template"/>
                                        <field name="data_model_id" invisible="is_template"/>
                                    </group>
                                    <group>
                                        <field name="heat" invisible="is_template == False"/>
                                        <field name="is_listed" invisible="is_template == False"/>
                                        <field name="is_valid" invisible="is_template == False"/>
                                        <field name="is_template" invisible="1"/>
                                        <field name="app_store_id" invisible="1" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>

    </data>
</odoo>
