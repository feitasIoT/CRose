<odoo>
    <data>

        <record id="view_fts_edge_node_tree" model="ir.ui.view">
            <field name="name">fts.edge.node.tree</field>
            <field name="model">fts.edge.node</field>
            <field name="arch" type="xml">
                <list string="Edge Node">
                    <field name="name"/>
                    <field name="ip_address"/>
                    <field name="port"/>
                    <field name="agent_port"/>
                    <field name="status" widget="badge" decoration-success="status == 'online'" decoration-warning="status == 'error'" decoration-muted="status == 'offline'"/>
                    <button name="action_open_vnc" type="object" icon="fa-eye" title="Remote Desktop"/>
                    <button name="action_view_instances" type="object" string="Instances"/>
                </list>
            </field>
        </record>

        <record id="view_fts_edge_node_kanban" model="ir.ui.view">
            <field name="name">fts.edge.node.kanban</field>
            <field name="model">fts.edge.node</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="version"/>
                    <field name="is_gateway"/>
                    <field name="status"/>
                    <field name="os_version"/>
                    <field name="is_frpc"/>
                    <field name="has_mqtt_broker"/>
                    <field name="has_nodered"/>
                    <field name="has_docker"/>
                    <field name="ip_address"/>
                    <field name="port"/>
                    <field name="agent_port"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click o_kanban_record feitas_iot_instance_kanban_card">
                                <div class="d-flex flex-column gap-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span t-attf-class="feitas_iot_status_dot feitas_iot_status_{{ record.status.raw_value }}"/>
                                        <strong class="text-truncate">
                                            <field name="name"/>
                                        </strong>
                                        <span t-if="record.is_gateway.raw_value" class="badge text-bg-info ms-auto">Gateway</span>
                                    </div>
                                    <div class="text-muted text-truncate">
                                        <span t-esc="record.ip_address.value"/>:<span t-esc="record.port.value"/>
                                    </div>
                                    <div class="text-muted text-truncate">
                                        Agent: <span t-esc="record.ip_address.value"/>:<span t-esc="record.agent_port.value"/>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <span t-if="record.is_frpc.raw_value" class="fa fa-random text-success" title="FRPC"/>
                                            <span t-else="" class="fa fa-random text-muted" title="FRPC"/>

                                            <span t-if="record.has_mqtt_broker.raw_value" class="fa fa-rss text-success" title="MQTT Broker"/>
                                            <span t-else="" class="fa fa-rss text-muted" title="MQTT Broker"/>

                                            <span t-if="record.has_nodered.raw_value" class="fa fa-sitemap text-success" title="Node-RED"/>
                                            <span t-else="" class="fa fa-sitemap text-muted" title="Node-RED"/>

                                            <span t-if="record.has_docker.raw_value" class="fa fa-cubes text-success" title="Docker"/>
                                            <span t-else="" class="fa fa-cubes text-muted" title="Docker"/>
                                        </div>
                                        <div class="feitas_iot_instance_kanban_actions d-flex align-items-center gap-1">
                                            <button type="object" name="action_open_vnc" class="btn btn-link btn-sm p-0 oe_kanban_action" title="Remote Desktop" icon="fa-eye"/>
                                            <button type="object" name="action_view_instances" class="btn btn-link btn-sm p-0 oe_kanban_action" title="Instances" icon="fa-th-large"/>
                                            <button type="object" name="action_view_logs" class="btn btn-link btn-sm p-0 oe_kanban_action" title="Logs" icon="fa-file-text-o"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_fts_edge_node_form" model="ir.ui.view">
            <field name="name">fts.edge.node.form</field>
            <field name="model">fts.edge.node</field>
            <field name="arch" type="xml">
                <form string="Node">
                    <header>
                        <button name="action_generate_config" type="object" string="Generate config" class="btn-primary" invisible="status != 'draft'"/>
                        <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="status != 'draft'"/>
                        <button name="action_view_logs" type="object" string="Logs" class="btn-secondary" invisible="status != 'online'"/>
                        <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_instances" type="object" class="oe_stat_button" icon="fa-th-large">
                                <field name="instance_count" widget="statinfo" string="Instances"/>
                            </button>
                            <button name="action_view_gateway_mqtt_users" type="object" class="oe_stat_button" icon="fa-users" invisible="not is_gateway">
                                <field name="gateway_mqtt_user_count" widget="statinfo" string="MQTT Users"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <!-- <field name="version"/> -->
                                <field name="is_template"/>
                                <field name="template_id" invisible="is_template"/>
                                <field name="os_version"/>
                                <!-- <field name="nr_node"/> -->
                                <field name="port"/>
                                <field name="agent_port"/>
                                <field name="use_redis" />
                            </group>
                            <group>
                                <field name="is_gateway" />
                                <field name="gateway_id" invisible="is_gateway"/>
                                <field name="ip_address"/>
                                <field name="another_ip_address"/>
                                <field name="is_frpc" invisible="not is_gateway"/>
                                <field name="has_nodered" />
                                <field name="has_docker" />
                                <field name="has_mqtt_broker" />
                                <field name="use_frp"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Basic">
                                <group>
                                    <group>
                                        <field name="ssh_username"/>
                                        <field name="ssh_password" password="True"/>
                                        <field name="ssh_port"/>
                                    </group>
                                    
                                    <group string="Applications">
                                        <field name="instance_id"/>
                                        

                                        <field name="flow_ids" nolabel="1" colspan="2">
                                            <list editable="bottom">
                                                <field name="flow_id" domain="[('is_template', '=', True)]"/>
                                            </list>
                                        </field>
                                    </group>
                                    <group string="MQTT Configuration">
                                        <field name="mqtt_broker_id"/>
                                        <field name="mqtt_account_id"/>
                                    </group>
                                    <group string="Redis Configuration">
                                        <field name="redis_account_id" readonly="1" invisible="not use_redis"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Deployment">
                                <group>
                                    <group string="Deployment Command">
                                        <field name="agent_cmd" nolabel="1" colspan="2"/>
                                    </group>
                                    <group string="Configuration File">
                                        <field name="config" nolabel="1" colspan="2"/>
                                    </group>
                                    
                                </group>
                                
                            </page>
                            <page string="Components">
                                <group>
                                    <group>
                                        <field name="frpc_webserver_port" invisible="not is_gateway"/>
                                        <field name="frpc_webserver_username" invisible="not is_gateway"/>
                                        <field name="frpc_webserver_password" password="True" invisible="not is_gateway"/>
                                    </group>
                                    <group>
                                        <field name="nodered_username" invisible="not has_nodered"/>
                                        <field name="nodered_password" password="True" invisible="not has_nodered"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_fts_edge_node_initialize" model="ir.actions.server">
            <field name="name">Initialize</field>
            <field name="model_id" ref="model_fts_edge_node"/>
            <field name="binding_model_id" ref="model_fts_edge_node"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">action = records.action_initialize()</field>
        </record>

    </data>
</odoo>
